                  "pm.test(\"TEST 3b: Ravi successfully hired Costume 15\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.hire.costume_id).to.eql(15);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
