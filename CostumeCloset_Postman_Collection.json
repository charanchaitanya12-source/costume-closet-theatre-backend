    {
      "name": "Double Booking Scenarios (Task 5)",
      "item": [
        {
          "name": "TEST 1 - Hire Costume 15 to Asha",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"actor_name\": \"Asha\",\n    \"costume_id\": 15\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hires",
              "host": ["{{baseUrl}}"],
              "path": ["hires"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"TEST 1: Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"TEST 1: Hire created for Costume 15\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.hire.costume_id).to.eql(15);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TEST 2 - Attempt Double Booking to Ravi",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"actor_name\": \"Ravi\",\n    \"costume_id\": 15\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hires",
              "host": ["{{baseUrl}}"],
              "path": ["hires"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"TEST 2: Status code is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"TEST 2: Error message is 'Costume 15 is already hired'\", function () {",
                  "    var json = pm.response.json();",
                  "    var msg = json.error || json.message;",
                  "    pm.expect(msg).to.eql(\"Costume 15 is already hired\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TEST 3a - Return Costume 15 from Asha",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"costume_id\": 15\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hires/return",
              "host": ["{{baseUrl}}"],
              "path": ["hires", "return"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"TEST 3a: Return returns 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"TEST 3a: Costume 15 returned successfully\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"returned\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TEST 3b - Hire Costume 15 to Ravi after Return",
          "request": {
            "method": "POST",
